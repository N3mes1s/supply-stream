/target
.DS_Store
.supply-stream-data/
.supply-stream-state/
.artifacts/
.cargo/
.claude/
.staging/

# Vendored yara-x: upstream's own crates.io exclusions (~48MB of PE/Mach-O/.NET
# module test samples + golden outputs; not needed to compile, only for
# `cargo test -p yara-x` on modules we don't maintain). See vendor/yara-x/VENDOR.md.
vendor/yara-x/lib/src/modules/**/*.zip
vendor/yara-x/lib/src/modules/**/*.out

# Build output of the vendored workspace (it is excluded from ours, so the
# root /target rule does not cover it)
vendor/yara-x/target/

# Local operator watch loops (ad-hoc, stateful; see scripts/stream-check.sh for
# the durable equivalent)
scripts/watch-stream-summary.sh
scripts/watch-worthy-diffs.sh

# Python bytecode from the fixture/scan scripts
__pycache__/
*.pyc
